# Copy to .env and fill in. Never commit .env.
# Empty values are fine for local CPU tests (mock and tiny backends).

# OpenRouter baseline. https://openrouter.ai/keys
# The baseline script reads this key. Reasoning effort for gpt-5-mini is a CLI
# flag (--reasoning-effort minimal|low), not an environment variable.
OPENROUTER_API_KEY=
OPENROUTER_MODEL=openai/gpt-4o-mini
# Fallback only. The baseline uses usage.cost from the response when OpenRouter sends it.
# List prices checked 10 Nov 2026.
OPENROUTER_INPUT_USD_PER_MILLION=0.15
OPENROUTER_OUTPUT_USD_PER_MILLION=0.60

# Hugging Face — dataset download and pushing adapters. https://huggingface.co/settings/tokens
HF_TOKEN=
HUGGING_FACE_HUB_TOKEN=

# Modal — https://modal.com/settings (token id + secret). Do not paste them into code.
MODAL_TOKEN_ID=
MODAL_TOKEN_SECRET=

# Langfuse — https://cloud.langfuse.com
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=
LANGFUSE_HOST=https://cloud.langfuse.com

# Gateway. Leave empty to disable auth on localhost. Set a long random value before exposing a port.
GATEWAY_API_KEY=
GATEWAY_RATE_LIMIT=60
GATEWAY_RATE_WINDOW_S=60

# Self-hosted GPU price used only when you set it, after you check the provider page.
# Modal L4 was about $0.80/h on 10 Nov 2026. Leave empty until you know the box you used.
LOCALLLM_GPU_USD_PER_HOUR=

MLFLOW_TRACKING_URI=file:./mlruns
VLLM_BASE_URL=http://127.0.0.1:8000/v1
LLAMACPP_BASE_URL=http://127.0.0.1:8081/v1
VLLM_BASE_MODEL=Qwen/Qwen2.5-1.5B-Instruct
VLLM_LORA_MODEL=spider-sql
VLLM_AWQ_MODEL=spider-sql-awq
GGUF_MODEL=spider-sql-q4
